{
  "name": "claudinha",
  "version": "0.3.2",
  "description": "A terminal manager for Claude Code.",
  "author": "Scott Florida",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottdflorida/claudinha.git"
  },
  "bugs": {
    "url": "https://github.com/scottdflorida/claudinha/issues"
  },
  "homepage": "https://github.com/scottdflorida/claudinha#readme",
  "main": "out/main/index.js",
  "bin": {
    "claudinha": "./bin/claudinha"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/build-app.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "generate:icon": "node scripts/generate-icon.mjs",
    "postinstall": "electron-rebuild"
  },
  "files": [
    "out",
    "bin",
    "assets",
    "scripts/claudinha-hook-relay.js",
    "scripts/claudinha-hook-relay.sh",
    "scripts/claudinha-statusline.js",
    "scripts/claudinha-statusline.sh"
  ],
  "dependencies": {
    "@electron/rebuild": "^3.7.1",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.2.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.8.0",
    "node-pty": "^1.0.0",
    "posthog-node": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.20",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.8.8",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
